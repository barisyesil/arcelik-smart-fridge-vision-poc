# `cdk deploy` çıktılarından doldurulur (infra/README.md'deki "Web arayüzü
# yapılandırması" bölümüne bakın). Boş bırakılırsa arayüzdeki "Bağlantı
# ayarları" panelinden elle girilebilir (tarayıcıda localStorage'da saklanır).

# CDK çıktısı: ApiUrl
VITE_API_URL=

# CDK çıktısı: CognitoDomain (Hosted UI taban URL'si)
VITE_COGNITO_DOMAIN=

# CDK çıktısı: WebTestClientId (mobil client'tan AYRI — web test aracı içindir)
VITE_COGNITO_CLIENT_ID=

# Prompt Lab yerel dev sunucusunun adresi (playground/server.py). Boş bırakılırsa
# http://localhost:8900 varsayılır; arayüzdeki Prompt Lab ekranından da
# değiştirilebilir (localStorage'da saklanır). Üretim akışıyla ilgisizdir.
VITE_PLAYGROUND_URL=http://localhost:8900
