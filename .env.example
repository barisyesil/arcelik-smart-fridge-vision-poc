# Bu dosya SADECE yerel gelistirme icindir ve repoda tutulur (degerler bos).
# Gercek sirlar SSM Parameter Store SecureString'te durur, Lambda ortam
# degiskeninde tutulmaz. Asagidakiler Lambda'ya gitmez.

# Yerel testte Gemini'yi gercekten cagirmak isterseniz:
GEMINI_API_KEY=

# Yerel/CI icin AWS bolgesi
AWS_REGION=eu-central-1

# Kimlik dogrulama yok; x-user-id header'i bu degeri tasir.
DEFAULT_USER_ID=u_demo
