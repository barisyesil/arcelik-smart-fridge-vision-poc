  "disclaimer": "Bu değerler üretici SKT/TETT bilgisinin yerine geçmez. Ambalaj tarihi varsa öncelik ambalaj tarihindedir. Görünüm ve koku gıda güvenliğini garanti etmez.",
  "default_conditions": {
    "refrigerator_max_c": 4,
    "freezer_max_c": -18,
    "fresh_on_entry_assumed": true,
    "cold_chain_intact_assumed": true
  },
  "calculation_policy": {
    "from_fridge_entry": "estimated_date = fridge_entry_at + recommended_days",
    "after_opening": "estimated_date = opened_at + recommended_days; opened_at bilinmiyorsa kullanıcıdan istenir",
    "package_date_required": "Ambalajdaki SKT/TETT kullanılır; after_opening değeri yalnızca ürün açılmışsa uygulanır",
    "from_freezer_entry": "quality_date = freezer_entry_at + recommended_days; kesintisiz -18 C veya altında saklama varsayılır",
    "not_applicable": "Tarih hesaplanmaz"
  },
